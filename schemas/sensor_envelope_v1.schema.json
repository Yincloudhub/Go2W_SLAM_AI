{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/sensor_envelope_v1.schema.json",
  "title": "Go2wSensorEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema",
    "source_id",
    "source_kind",
    "timestamp_ms",
    "received_ms",
    "sequence",
    "age_ms",
    "stale_ms",
    "frame_id",
    "status",
    "confidence",
    "calibration_status",
    "calibration_id",
    "producer",
    "producer_instance_id",
    "status_reasons",
    "payload"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "schema": {"const": "go2w_sensor_envelope_v1"},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "source_kind": {"type": "string", "minLength": 1, "maxLength": 64},
    "timestamp_ms": {
      "anyOf": [
        {"type": "integer", "minimum": 1},
        {"type": "null"}
      ]
    },
    "received_ms": {"type": "integer", "minimum": 1},
    "sequence": {
      "anyOf": [
        {"type": "integer", "minimum": 0},
        {"type": "null"}
      ]
    },
    "age_ms": {
      "anyOf": [
        {"type": "integer"},
        {"type": "null"}
      ]
    },
    "stale_ms": {"type": "integer", "minimum": 1},
    "frame_id": {
      "anyOf": [
        {"type": "string", "minLength": 1, "maxLength": 128},
        {"type": "null"}
      ]
    },
    "status": {
      "type": "string",
      "enum": ["fresh", "stale", "offline", "invalid", "uncalibrated"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "calibration_status": {
      "type": "string",
      "enum": ["verified", "engineering_released", "pending", "not_required", "invalid", "unknown"]
    },
    "calibration_id": {
      "anyOf": [
        {"type": "string", "minLength": 1, "maxLength": 128},
        {"type": "null"}
      ]
    },
    "producer": {"type": "string", "minLength": 1, "maxLength": 128},
    "producer_instance_id": {
      "anyOf": [
        {"type": "string", "minLength": 1, "maxLength": 256},
        {"type": "null"}
      ]
    },
    "status_reasons": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "fresh"}}},
      "then": {
        "properties": {
          "timestamp_ms": {"type": "integer", "minimum": 1},
          "age_ms": {"type": "integer", "minimum": 0},
          "sequence": {"type": "integer", "minimum": 0},
          "producer_instance_id": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"calibration_status": {"const": "verified"}}},
      "then": {
        "properties": {
          "calibration_id": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "uncalibrated"}}},
      "then": {
        "properties": {
          "calibration_status": {
            "enum": ["pending", "invalid", "unknown"]
          }
        }
      }
    }
  ]
}
