{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/d435_perception_summary.schema.json",
  "title": "Go2wD435PerceptionSummary",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "schema",
    "source",
    "source_id",
    "source_kind",
    "producer",
    "generated_at_ms",
    "timestamp_ms",
    "generation_id",
    "status",
    "stale",
    "frame_sequence",
    "sensor_timestamp_ms",
    "confidence",
    "owner",
    "capture",
    "depth",
    "yolo",
    "degraded_capabilities",
    "policy"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "schema": {"const": "go2w_d435_perception_summary_v1"},
    "source": {"const": "d435_perception"},
    "source_id": {"const": "d435_rgbd"},
    "source_kind": {"const": "rgbd_perception"},
    "producer": {"const": "d435_perception_sidecar"},
    "generated_at_ms": {"type": "integer"},
    "timestamp_ms": {"type": "integer"},
    "generation_id": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["fresh", "stale", "offline", "invalid", "uncalibrated"]
    },
    "stale": {"type": "boolean"},
    "frame_sequence": {"type": ["integer", "null"]},
    "sensor_timestamp_ms": {"type": ["number", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "sensor_timestamp_domain": {"type": ["string", "null"]},
    "owner": {
      "type": "object",
      "required": [
        "pid",
        "running",
        "expected_process",
        "process_start_ticks",
        "boot_id",
        "status"
      ],
      "properties": {
        "pid": {"type": ["integer", "null"]},
        "running": {"type": "boolean"},
        "expected_process": {"type": "string"},
        "process_start_ticks": {"type": ["integer", "null"]},
        "boot_id": {"type": ["string", "null"]},
        "status": {"enum": ["owned", "offline"]}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "frame_sequence",
        "sensor_timestamp_ms",
        "captured_at_ms",
        "age_ms",
        "stale_ms",
        "frame_id"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["fresh", "stale", "offline", "invalid", "uncalibrated"]
        },
        "frame_sequence": {"type": ["integer", "null"]},
        "sensor_timestamp_ms": {"type": ["number", "null"], "minimum": 0},
        "captured_at_ms": {"type": "integer"},
        "age_ms": {"type": ["integer", "null"]},
        "stale_ms": {"type": "integer", "minimum": 1},
        "frame_id": {"type": "string", "minLength": 1}
      }
    },
    "depth": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source",
        "timestamp_ms",
        "frame_sequence",
        "sensor_timestamp_ms",
        "frame_id",
        "front_clearance_m",
        "left_clearance_m",
        "right_clearance_m",
        "center_distance_m",
        "confidence",
        "roi_confidence",
        "age_ms",
        "stale_ms",
        "stale",
        "source_status",
        "producer",
        "generation_id"
      ],
      "properties": {
        "source": {"const": "stereo_depth"},
        "timestamp_ms": {"type": "integer"},
        "frame_sequence": {"type": ["integer", "null"]},
        "sensor_timestamp_ms": {"type": ["number", "null"], "minimum": 0},
        "sensor_timestamp_domain": {"type": ["string", "null"]},
        "frame_id": {"type": "string", "minLength": 1},
        "front_clearance_m": {"type": ["number", "null"], "minimum": 0},
        "left_clearance_m": {"type": ["number", "null"], "minimum": 0},
        "right_clearance_m": {"type": ["number", "null"], "minimum": 0},
        "center_distance_m": {"type": ["number", "null"], "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "roi_confidence": {
          "type": "object",
          "additionalProperties": true,
          "required": ["front", "left", "right", "center_window"],
          "properties": {
            "front": {"type": "number", "minimum": 0, "maximum": 1},
            "left": {"type": "number", "minimum": 0, "maximum": 1},
            "right": {"type": "number", "minimum": 0, "maximum": 1},
            "center_window": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "age_ms": {"type": ["integer", "null"]},
        "stale_ms": {"type": "integer", "minimum": 1},
        "stale": {"type": "boolean"},
        "source_status": {
          "type": "string",
          "enum": ["fresh", "stale", "offline", "invalid", "uncalibrated"]
        },
        "producer": {"const": "d435_perception_sidecar"},
        "generation_id": {"type": "string", "minLength": 1}
      }
    },
    "yolo": {"type": "object"},
    "degraded_capabilities": {
      "type": "array",
      "items": {"type": "string"}
    },
    "policy": {
      "type": "object",
      "required": ["motion_authority", "depth_role", "yolo_role", "llm_direct_motion"],
      "properties": {
        "motion_authority": {"const": "slam_gateway"},
        "llm_direct_motion": {"const": false}
      }
    }
  }
}
