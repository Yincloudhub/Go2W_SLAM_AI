{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/task_queue.schema.json",
  "title": "Go2wTaskQueue",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "queue_id",
    "mode",
    "status",
    "source",
    "targets",
    "steps",
    "communication_policy"
  ],
  "properties": {
    "queue_id": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "enum": ["sequential"]},
    "status": {"type": "string", "enum": ["planned", "running", "completed", "failed", "blocked"]},
    "source": {
      "type": "string",
      "enum": ["semantic_topology", "deterministic_cpp", "llm_fallback", "operator_panel", "scripted"]
    },
    "targets": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "steps": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"$ref": "#/$defs/step"}},
    "communication_policy": {"$ref": "local_llm_plan.schema.json#/$defs/communication_policy"},
    "user_reply": {"type": "string"},
    "weak_link_payload": {"type": "object"}
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": true,
      "required": ["task_id", "action", "status"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "action": {
          "type": "string",
          "enum": [
            "navigate",
            "wait_until",
            "capture_keyframe",
            "report",
            "speak",
            "ask_confirm",
            "hold_position",
            "set_communication_policy"
          ]
        },
        "status": {"type": "string", "enum": ["pending", "running", "ok", "failed", "blocked", "dry_run", "skipped"]},
        "target_node": {"type": "string"},
        "target_name": {"type": "string"},
        "message": {"type": "string"},
        "requires_preflight": {"type": "boolean"},
        "semantic_reason": {"type": "string"}
      }
    }
  }
}
